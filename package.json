{
  "name": "mx-img",
  "version": "0.4.0",
  "description": "Progressive Fourier spectrum image encoder, decoder, and streaming custom element (<mx-img />)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js",
      "default": "./dist/build.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/types",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "build": "bun run scripts/build-lib.ts",
    "prepare": "bun run build",
    "test": "bun test",
    "encode": "bun run src/utils/encoding/encoder.ts",
    "decode": "bun run src/utils/encoding/decoder.ts",
    "build:assets": "bun run src/build/builder.ts",
    "server": "bun run src/server/stream-server.ts",
    "mockup": "bun run src/client/mockup/static-server.ts",
    "typecheck": "bun x tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2"
  }
}
